__pycache__/
*.py[cod]

# Extraction output. Game data never belongs in this repo — it stays in the
# user's own copy of the game.
#
# These are directory-scoped on purpose. Do NOT add bare extension globs like
# *.MD or *.MP here: Windows matches ignore patterns case-insensitively, so
# *.MD silently swallows every .md document in docs/.
/unpacked/
/out/
/extracted/
/dump/

# .NET build output
bin/
obj/
*.user

# Android dev-build symbol dumps (binary-derived, oracle only)
/analysis/libfox-symbols.txt
/analysis/*.so
libfox.so

# Session working files under analysis/: oracle disassembly, one-off probe
# scripts, captures and logs. The committed .json files there are recovered
# data and stay tracked.
/analysis/*.asm
/analysis/*.png
/analysis/*.log
/analysis/probe_*.py
/analysis/sweep_*.py
